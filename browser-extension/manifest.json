{
  "manifest_version": 3,
  "name": "Taskbar Player",
  "version": "1.0.0",
  "description": "Передаёт мини-плееру Taskbar Player, что играет в Яндекс Музыке, даже из фоновой вкладки. Данные уходят только на 127.0.0.1.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.yandex.ru/*",
        "https://music.yandex.com/*",
        "https://music.yandex.by/*",
        "https://music.yandex.kz/*",
        "https://music.yandex.uz/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://127.0.0.1/*"]
}
